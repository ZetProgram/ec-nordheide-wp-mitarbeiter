{
    "name": "zetprogram/ec-nordheide-wp-mitarbeiter",
    "type": "project",
    "description": "EC Nordheide Mitarbeiter Plugin",
    "license": "proprietary",
    "require": {},
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "wp-coding-standards/wpcs": "^3.0",
        "symfony/polyfill-php80": "^1.30"
    },
    "scripts": {
        "lint": "vendor/bin/phpcs -p --standard=ruleset.xml .",
        "fix": "vendor/bin/phpcbf -p --standard=ruleset.xml . || true"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}