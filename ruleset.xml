<?xml version="1.0"?>
<ruleset name="Theme PHP Compatibility">
  <description>Prüft nur die PHP-Version-Kompatibilität (7.4–8.3).</description>

  <!-- Nur PHPCompatibility -->
  <rule ref="PHPCompatibilityWP"/>

  <!-- Ziel-PHP-Versionen -->
  <config name="testVersion" value="7.4-8.3"/>

  <!-- Nur Fehler zählen, keine Warnings -->
  <config name="ignore_warnings_on_exit" value="1"/>

  <!-- Theme-Ordner scannen -->
  <file>./</file>

  <!-- Unwichtige Ordner ausschließen -->
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>lib/plugin-update-checker/*</exclude-pattern>
  <exclude-pattern>*.min.js</exclude-pattern>
</ruleset>
